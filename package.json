{
  "name": "recommand-docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate:api": "bun run scripts/generate-openapi.mts",
    "dev": "bun run generate:api && next dev --turbopack",
    "build": "bun run generate:api && next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "format": "biome format --write .",
    "lint:links": "bun run scripts/lint-links.ts",
    "lint:guides": "bun run scripts/lint-guides.ts",
    "lint:api-paths": "bun run scripts/lint-api-paths.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fuma-translate/react": "^1.0.2",
    "@fumadocs/json-schema": "0.2.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "feed": "^5.2.1",
    "fumadocs-core": "16.16.0",
    "fumadocs-mdx": "14.3.2",
    "fumadocs-openapi": "12.2.0",
    "fumadocs-ui": "16.16.0",
    "lucide-react": "^1.51.0",
    "next": "16.3.8",
    "next-plausible": "^3.12.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "next-validate-link": "^1.6.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "mdast-util-to-markdown": "2.1.2"
  }
}
