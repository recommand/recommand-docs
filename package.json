{
  "name": "recommand-docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate:api": "bun run scripts/generate-openapi.mts",
    "dev": "bun run generate:api && next dev --turbopack",
    "build": "bun run generate:api && next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "format": "biome format --write .",
    "lint:links": "bun run scripts/lint-links.ts",
    "lint:guides": "bun run scripts/lint-guides.ts",
    "lint:api-paths": "bun run scripts/lint-api-paths.ts"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "feed": "^5.2.1",
    "fumadocs-core": "16.6.17",
    "fumadocs-mdx": "14.2.10",
    "fumadocs-openapi": "10.3.18",
    "fumadocs-ui": "16.6.17",
    "lucide-react": "^0.575.0",
    "next": "16.3.8",
    "next-plausible": "^3.12.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shiki": "^3.23.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "@biomejs/biome": "2.4.9",
    "next-validate-link": "^1.6.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "patchedDependencies": {
    "fumadocs-openapi@10.3.18": "patches/fumadocs-openapi@10.3.18.patch"
  },
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
